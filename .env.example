# Copy to ".env" (same folder as this file) and edit. Real environment variables override this file. Never commit .env.

# --- Language model for chat and plan overviews (optional; leave empty for the built-in rule-based assistant, which is free)
# Free option 1, hosted (free key from console.groq.com, no card):
#   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_API_KEY=your-key   LLM_MODEL=llama-3.3-70b-versatile
# Free option 1b, Google Gemini (key from aistudio.google.com, sign in with a Google account):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_API_KEY=your-key   LLM_MODEL=gemini-2.0-flash
# Free option 2, OpenRouter (openrouter.ai, models ending in ":free"):
#   LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_API_KEY=your-key   LLM_MODEL=<a model ending in :free>
# Free option 3, on your own PC with Ollama (no key, no internet):
#   LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:3b
# Model names change often, so check the provider's list if one stops working.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Destination pictures: with Gemini chat above, the same key is reused. Or set a separate key here. Image models may need a paid
# Gemini plan; without one the app keeps its drawn illustrations.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# xAI Grok (console.x.ai): one key for chat AND destination pictures. LLM_BASE_URL, if set, wins for chat.
# Check the model names in the xAI console; they change often.
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_IMAGE_MODEL=grok-2-image
# Paid, only if you ever want it (ignored while LLM_BASE_URL is set):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Accounts
# The account with this email can retrain the ranking from Settings.
ADMIN_EMAIL=
# Set to 1 when the site is served over HTTPS so the login cookie is marked Secure.
COOKIE_SECURE=0
# Public address used in password-reset emails, e.g. https://roamly.example. Required when deployed: without it, reset links
# are only sent when the site is opened on localhost (the Host header is not trusted), and a warning is logged instead.
BASE_URL=

# --- Password-reset email (optional). Without SMTP_HOST the reset link is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Map tiles (CARTO basemaps). The key is appended as ?key=... unless MAP_TILE_URL contains {key}.
CARTO_API_KEY=
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# --- Where the databases are stored (default: the data/ folder)
# TRAVEL_DATA_DIR=/data
